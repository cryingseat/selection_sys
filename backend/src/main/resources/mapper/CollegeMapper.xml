<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.labselection.mapper.CollegeMapper">
    <select id="findAll" resultType="College">
        SELECT * FROM college ORDER BY sort_order, id
    </select>

    <select id="findById" resultType="College">
        SELECT * FROM college WHERE id = #{id}
    </select>

    <select id="findByCode" resultType="College">
        SELECT * FROM college WHERE code = #{code}
    </select>
</mapper>
